<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 配色は docs/design-spec-v2.md の bg (#0E0F11)。ダーク固定 -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#0E0F11</item>
        <item name="colorPrimaryDark">#0E0F11</item>
        <item name="colorAccent">#F0D870</item>
        <item name="android:windowBackground">#0E0F11</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">#0E0F11</item>
        <item name="android:navigationBarColor">#0E0F11</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0E0F11</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
