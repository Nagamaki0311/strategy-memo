<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 配色は docs/design-spec.md の bg (#16140F)。ダーク固定 -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#16140F</item>
        <item name="colorPrimaryDark">#16140F</item>
        <item name="colorAccent">#F0D870</item>
        <item name="android:windowBackground">#16140F</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">#16140F</item>
        <item name="android:navigationBarColor">#16140F</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#16140F</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
